# PDU Manager secrets (example) — copy to /etc/pdu-control/secrets.env on the target VM
# and fill in REAL values. This file contains placeholders only; never commit the real file.
#
# All values are base64-encoded (the app decodes them at load).
# Generate: printf 'your-secret' | base64
#
# PDU SSH (PowerAlert) credentials
PDU_USER_B64=
PDU_PASS_B64=

# SNMP (loaded for compatibility; UNUSED by the live V3 app modules)
SNMP_VERSION_B64=
SNMP_RO_B64=
SNMP_RW_B64=

# Emergency web login (UI-only; == pdu-admin; also derives the Flask session
# signing key — rotating it rotates the signing key)
WEB_USER_B64=
WEB_PASS_B64=

# LLDAP service bind (group search only; account must NOT be in pdu-* groups)
LDAP_SERVICE_USER_B64=
LDAP_SERVICE_PASS_B64=

# Ownership/permissions on the real file:
#   chown root:pducontrol /etc/pdu-control/secrets.env
#   chmod 640 /etc/pdu-control/secrets.env